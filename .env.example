# ─── Backend ─────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_me_to_a_random_string

# ─── Ollama ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3          # or mistral, phi3, etc.
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=512

# ─── Whisper STT ─────────────────────────────────────────
WHISPER_MODEL=base           # tiny | base | small | medium | large
WHISPER_DEVICE=cpu           # cpu | cuda

# ─── Piper TTS ───────────────────────────────────────────
PIPER_MODEL_PATH=/models/piper/en_US-lessac-medium.onnx
PIPER_SAMPLE_RATE=22050

# ─── Supabase / PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql://postgres:password@db:5432/voiceai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ─── Asterisk ────────────────────────────────────────────
ASTERISK_HOST=asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_SECRET=change_me

# ─── Booking ─────────────────────────────────────────────
# Cal.com (self-hosted)
CALCOM_BASE_URL=http://calcom:3000
CALCOM_API_KEY=your-calcom-api-key

# Google Calendar (alternative)
GOOGLE_CALENDAR_CREDENTIALS_PATH=/secrets/google_credentials.json
GOOGLE_CALENDAR_ID=primary

# ─── Email (Brevo / Sendinblue free tier) ────────────────
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM_ADDRESS=receptionist@yourdomain.com
EMAIL_FROM_NAME=AI Receptionist

# ─── n8n ─────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook

# ─── Audio ───────────────────────────────────────────────
AUDIO_SAMPLE_RATE=8000       # Asterisk default
AUDIO_TEMP_DIR=/tmp/audio
